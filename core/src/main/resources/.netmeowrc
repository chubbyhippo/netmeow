" ============================================================================
" .netmeowrc — THE default keymap of the netmeow plugin
" ----------------------------------------------------------------------------
" The plugin binds no keys in code: this file defines every default — the
" NORMAL/MOTION layout, the Emacs chord layer and the whole SPC keypad table —
" and ships bundled inside the module jar. A ~/.netmeowrc in your home
" directory overrides it entry by entry — only the lines you change matter; a
" deleted line falls back to the bundled default (bind `ignore` to disable a
" key). Open it with SPC c m — the first press creates ~/.netmeowrc as a full
" copy of this file; reload after editing with SPC c M.
" Within this file, a later line for the same key wins.
"
" Syntax:
"   nmap <key> <action>(ActionId)      NORMAL-mode key -> IDE action
"   nmap <key> <meow-command>          NORMAL-mode key -> named meow command
"   nmap <key> <meow keys>             NORMAL-mode key -> replayed meow keys
"   nnoremap ...                       like nmap, but the RHS resolves through
"                                      these bundled defaults
"   mmap / mnoremap <key> <target>     the same, for MOTION mode (the keymap of
"                                      workbench trees)
"   cmap / cnoremap <chord> <target>   the Emacs modifier-chord layer
"   map <leader><seq> <target>         keypad (SPC) entry
"   desc <leader><seq> <text>          which-key label for an entry or a group
"   set timeoutlen=300                 which-key popup delay in ms
"   set nowhich-key                    turn the which-key popup off
"   set overlay-color=#2ECC71          avy/ace label background (#RRGGBB)
"   set overlay-text-color=#ffffff     avy/ace label text
"   set expand-hint-color=#2b5db2      0-9 expand-hint color
"   set grab-color=#cde8cd             grab / beacon highlight
"
" ACTION IDS. An <action>(...) target is one of two things:
"   1. a global action id, spelled as the module layer spells it —
"      org-netbeans-modules-openfile-OpenFileAction — found by searching every
"      Actions/ category, nested ones included;
"   2. an editor action name — format, fix-imports, select-word — invoked off
"      the focused editor's ActionMap. Some are registered per language, so a
"      Java-only action does nothing in another editor.
" Dashes and dots are interchangeable in an id: both spellings normalize to the
" same action.
" ============================================================================

set which-key
set timeoutlen=300

" Overlay colors — #RRGGBB, applied to both the light and dark themes. The two
" label colors below sit at their defaults; expand-hint and grab are commented
" so their built-in defaults stand — uncomment to pin your own.
set overlay-color=#2ECC71
set overlay-text-color=#ffffff
" set expand-hint-color=#2b5db2
" set grab-color=#cde8cd

" ============================================================================
" The meow layout — QWERTY by default, every key rebindable
" ----------------------------------------------------------------------------
" SPC is the keypad key and cannot be remapped; ESC and modifier chords never
" reach the modal engine as typing (the chords live in the cmap layer below).
" ============================================================================

" expand / counts
nmap 0 meow-expand-0
nmap 1 meow-expand-1
nmap 2 meow-expand-2
nmap 3 meow-expand-3
nmap 4 meow-expand-4
nmap 5 meow-expand-5
nmap 6 meow-expand-6
nmap 7 meow-expand-7
nmap 8 meow-expand-8
nmap 9 meow-expand-9
nmap - meow-negative-argument

" selections / things
nmap ; meow-reverse
nmap , meow-inner-of-thing
nmap . meow-bounds-of-thing
nmap [ meow-beginning-of-thing
nmap ] meow-end-of-thing
nmap < meow-beginning-of-thing
nmap > meow-end-of-thing

" the letter keys
nmap a meow-append
nmap A meow-open-below
nmap b meow-back-word
nmap B meow-back-symbol
nmap c meow-change
nmap d meow-delete
nmap D meow-backward-delete
nmap e meow-next-word
nmap E meow-next-symbol
nmap f meow-find
nmap g meow-cancel-selection
nmap G meow-grab
nmap h meow-left
nmap H meow-left-expand
nmap i meow-insert
nmap I meow-open-above
nmap j meow-next
nmap J meow-next-expand
nmap k meow-prev
nmap K meow-prev-expand
nmap l meow-right
nmap L meow-right-expand
nmap m meow-join
nmap n meow-search
nmap o meow-block
nmap O meow-to-block
nmap p meow-yank
nmap q meow-quit
nmap r meow-replace
nmap R meow-swap-grab
nmap s meow-kill
nmap t meow-till
nmap u meow-undo
nmap U meow-undo-in-selection
nmap v meow-visit
nmap w meow-mark-word
nmap W meow-mark-symbol
nmap x meow-line
nmap X meow-goto-line
nmap y meow-save
nmap Y meow-sync-grab
nmap z meow-pop-selection
nmap ' repeat

" --- avy jumps ---------------------------------------------------------------
" S = avy-goto-char-timer, Q = avy-goto-line. Type chars (0.25 s pause labels
" the matches), then hit a label key; Q labels visible lines, digits switch to
" a line-number prompt.
nmap S avy-goto-char-timer
nmap Q avy-goto-line

" MOTION mode — the keymap of workbench trees (Projects, Files, Navigator,
" search results, ...): j/k/h/l move like the arrow keys (h collapses or goes
" to the parent, l expands or enters), q hides the window, and every unmapped
" key keeps its native meaning. Read-only editors do NOT use MOTION; they stay
" NORMAL with the modify commands inert. `mmap <key> ignore` gives a key back
" to the tree.
mmap j meow-next
mmap k meow-prev
mmap h meow-left
mmap l meow-right
mmap q <action>(netmeow.hideView)

" ============================================================================
" The Emacs chord layer — modifier-key bindings, like the vanilla Emacs keymap
" ----------------------------------------------------------------------------
" Unlike the single-key layout above, these are Ctrl-/Alt- CHORDS. They fire
" only outside INSERT and, like meow's own motions, EXTEND an active selection
" instead of replacing it (so C-f after a selection grows it). Either spelling
" works: the Emacs one (C-f, M-<) or the host one (control F, alt shift COMMA).
" An unbound chord stays the IDE's; to hand a bound one back, map it to
" `ignore` — e.g. `cmap C-f ignore` restores Find.
" ============================================================================

" point motions (C-f C-b C-n C-p C-a C-e, M-f M-b M-a M-e)
cmap C-f forward-char
cmap C-b backward-char
cmap C-n next-line
cmap C-p previous-line
cmap C-a move-beginning-of-line
cmap C-e move-end-of-line
cmap M-f forward-word
cmap M-b backward-word
cmap M-a backward-sentence
cmap M-e forward-sentence

" buffer + paragraph (M-< M-> M-{ M-})
cmap M-< beginning-of-buffer
cmap M-> end-of-buffer
cmap M-{ backward-paragraph
cmap M-} forward-paragraph

" case + kill (M-u M-l M-c M-d)
cmap M-u upcase-word
cmap M-l downcase-word
cmap M-c capitalize-word
cmap M-d kill-word

" stock-Emacs edit chords. Each maps onto the meow command that IS the Emacs
" one (meow-semantics.md): meow-kill's no-selection fallback is meow-C-k, so
" C-k kills the line and C-w the region through the same command; meow-save is
" kill-ring-save; meow-cancel-selection is keyboard-quit; meow-delete is
" delete-forward-char. These fire only outside INSERT, so the IDE keeps them
" while you type.
cmap C-/ meow-undo
cmap C-_ meow-undo
cmap C-d meow-delete
cmap C-k meow-kill
cmap C-w meow-kill
cmap M-w meow-save
cmap C-y meow-yank
cmap C-g meow-cancel-selection

" stock-Emacs whitespace and line chords. M-^ is meow-join + kill: the ledger
" records that killing the join selection IS delete-indentation, so it needs no
" command of its own.
cmap M-m back-to-indentation
cmap C-o open-line
cmap M-\ delete-horizontal-space
cmap M-SPC just-one-space
cmap M-^ ms

" ============================================================================
" The keypad (SPC) table
" ----------------------------------------------------------------------------
" Group names follow the Emacs prefixes: SPC x / c / m = the C-x / C-c / M-
" keymaps. SPC 0-9 (digit argument), SPC ? (cheatsheet) and SPC / (describe
" key) are reserved by the keypad itself and cannot be remapped.
" ============================================================================

" SPC SPC: ace-click — label every clickable UI element, then pick one
desc <leader><Space> ace-click
map <leader><Space> <action>(netmeow.aceClick)

" --- SPC b — bookmarks / buffers ---------------------------------------------
" NetBeans has no numbered bookmark slots, so where ideameow puts b0-b9 this
" walks the bookmarks instead: n next, p previous, c clear this file's.
desc <leader>b bookmark (m set / n p walk / j jump) · b buffers
map <leader>bb <action>(org-netbeans-modules-openfile-RecentFileAction)
desc <leader>bb recent files
map <leader>bm <action>(bookmark-toggle)
desc <leader>bm toggle bookmark
map <leader>bj <action>(org-netbeans-modules-editor-bookmarks-ui-BookmarksViewOpenAction)
desc <leader>bj bookmarks window
map <leader>bn <action>(bookmark-next)
desc <leader>bn next bookmark
map <leader>bp <action>(bookmark-previous)
desc <leader>bp previous bookmark
map <leader>bc <action>(clear-document-bookmarks)
desc <leader>bc clear bookmarks

" --- SPC x = C-x — files / buffers / windows ---------------------------------
desc <leader>x C-x · file / buffer / window
map <leader>xf <action>(org-netbeans-modules-jumpto-file-FileSearchAction)
desc <leader>xf goto file
" SPC x z = C-x z: repeat the last command (then bare z keeps repeating)
map <leader>xz repeat
desc <leader>xz repeat
map <leader>xs <action>(org-openide-actions-SaveAllAction)
desc <leader>xs save all
map <leader>xb <action>(org-netbeans-modules-openfile-RecentFileAction)
desc <leader>xb recent files
map <leader>xk <action>(org-netbeans-core-windows-actions-CloseWindowAction)
desc <leader>xk close tab
map <leader>xd <action>(org-netbeans-modules-project-ui-logical-tab-action)
desc <leader>xd projects window
map <leader>xg <action>(org-netbeans-modules-git-ui-status-OpenStatusAction)
desc <leader>xg git status
map <leader>xj <action>(org-netbeans-modules-project-ui-SelectInProjects)
desc <leader>xj select in projects
map <leader>xe <action>(org-netbeans-modules-editor-macros-MacroDialogSupport$RunMacroAction)
desc <leader>xe run macro
map <leader>xo <action>(netmeow.aceWindow)
desc <leader>xo ace-window
map <leader>xu <action>(org-netbeans-modules-localhistory-ui-view-ShowHistoryAction)
desc <leader>xu local history
map <leader>xc <action>(org-netbeans-modules-project-ui-CloseProject)
desc <leader>xc close project
map <leader>x0 <action>(org-netbeans-core-multiview-ClearSplitAction)
desc <leader>x0 unsplit
map <leader>x1 <action>(org-netbeans-core-multiview-ClearSplitAction)
desc <leader>x1 unsplit
map <leader>x2 <action>(org-netbeans-core-multiview-SplitDocumentHorizontallyAction)
desc <leader>x2 split right
map <leader>x3 <action>(org-netbeans-core-multiview-SplitDocumentVerticallyAction)
desc <leader>x3 split down

" --- SPC x p = C-x p — project -----------------------------------------------
desc <leader>xp C-x p · project
map <leader>xpf <action>(org-netbeans-modules-jumpto-file-FileSearchAction)
desc <leader>xpf goto file
map <leader>xpb <action>(org-netbeans-modules-openfile-RecentFileAction)
desc <leader>xpb recent files
map <leader>xpg <action>(org-netbeans-modules-search-FindInFilesAction)
desc <leader>xpg find in projects
map <leader>xpr <action>(org-netbeans-modules-search-ReplaceInFilesAction)
desc <leader>xpr replace in projects
map <leader>xpc <action>(org-netbeans-modules-project-ui-BuildProject)
desc <leader>xpc build project

" --- SPC x r = C-x r — bookmarks ---------------------------------------------
desc <leader>xr C-x r · bookmarks
map <leader>xrb <action>(org-netbeans-modules-editor-bookmarks-ui-BookmarksViewOpenAction)
desc <leader>xrb bookmarks window

" --- SPC c = C-c — personal commands ----------------------------------------
desc <leader>c C-c · commands (= M-m)
map <leader>cf <action>(org-netbeans-modules-jumpto-file-FileSearchAction)
desc <leader>cf goto file
map <leader>cs <action>(org-openide-actions-SaveAllAction)
desc <leader>cs save all
map <leader>ck <action>(org-netbeans-core-windows-actions-CloseWindowAction)
desc <leader>ck close tab
map <leader>cr <action>(org-netbeans-modules-search-FindInFilesAction)
desc <leader>cr find in projects
map <leader>ce <action>(select-word)
desc <leader>ce select word
map <leader>ca <action>(org-netbeans-modules-tasklist-ui-TaskListAction)
desc <leader>ca to-do window
map <leader>cl <action>(org-netbeans-modules-utilities-CopyPathToClipboard)
desc <leader>cl copy path
map <leader>cg <action>(org-netbeans-modules-git-ui-status-OpenStatusAction)
desc <leader>cg git status

" SPC c m / M: edit / reload ~/.netmeowrc — reload saves a dirty rc editor first
map <leader>cm <action>(netmeow.editRc)
desc <leader>cm edit .netmeowrc
map <leader>cM <action>(netmeow.reloadRc)
desc <leader>cM reload .netmeowrc

" SPC c j: avy jumps
desc <leader>cj C-c j · avy jump
map <leader>cjw avy-goto-char-timer
map <leader>cjc avy-goto-char-timer
map <leader>cjl avy-goto-line

" --- SPC m = M- — meta -------------------------------------------------------
" The M- motions and edits, mirroring the cmap chords above so the keypad
" reaches them too (SPC m f = M-f = forward-word, SPC m d = M-d, ...), the way
" Emacs' meow keypad exposes the whole M- map under SPC m.
desc <leader>m M- · meta
map <leader>ma backward-sentence
map <leader>mb backward-word
map <leader>mc capitalize-word
map <leader>md kill-word
map <leader>me forward-sentence
map <leader>mf forward-word
map <leader>ml downcase-word
map <leader>mu upcase-word
map <leader>m< beginning-of-buffer
map <leader>m> end-of-buffer
map <leader>m{ backward-paragraph
map <leader>m} forward-paragraph
map <leader>mx <action>(org-netbeans-modules-quicksearch-QuickSearchAction)
desc <leader>mx quick search (M-x)
map <leader>mo avy-goto-char-timer
map <leader>mr <action>(select-word)
desc <leader>mr select word
map <leader>my <action>(clipboard-history)
desc <leader>my clipboard history
map <leader>m. <action>(goto-declaration)
desc <leader>m. goto declaration
map <leader>m, <action>(jump-list-last-edit)
desc <leader>m, last edit location
map <leader>mg avy-goto-line

desc <leader>ms M-s · search
map <leader>msr <action>(org-netbeans-modules-search-FindInFilesAction)
desc <leader>msr find in projects
map <leader>msl <action>(find)
desc <leader>msl find
map <leader>mss <action>(find)
desc <leader>mss find
map <leader>msL <action>(org-netbeans-modules-search-FindInFilesAction)
desc <leader>msL find in projects
map <leader>mso <action>(org-netbeans-modules-java-navigation-actions-ShowMembersAction)
desc <leader>mso inspect members

" --- SPC w — the window map (Emacs C-c w) ------------------------------------
desc <leader>w window map (Emacs C-c w)
" v/s: split the editor side-by-side / stacked
map <leader>wv <action>(org-netbeans-core-multiview-SplitDocumentVerticallyAction)
desc <leader>wv split down
map <leader>ws <action>(org-netbeans-core-multiview-SplitDocumentHorizontallyAction)
desc <leader>ws split right
map <leader>wd <action>(org-netbeans-core-multiview-ClearSplitAction)
desc <leader>wd unsplit
map <leader>wD <action>(org-netbeans-core-multiview-ClearSplitAction)
desc <leader>wD unsplit
map <leader>wm <action>(org-netbeans-core-multiview-ClearSplitAction)
desc <leader>wm unsplit
map <leader>ww <action>(netmeow.aceWindow)
desc <leader>ww ace-window
map <leader>wW <action>(netmeow.aceSwapWindow)
desc <leader>wW ace-swap-window
" r: ace-resize — label every divider (editor splits AND window edges), pick
" one, then h/l or Left/Right resize side dividers, j/k or Down/Up resize
" top/bottom; ESC or any other key ends the hold
map <leader>wr <action>(netmeow.aceResize)
desc <leader>wr ace-resize
" n/p (aliases . and ,): cycle editor tabs (C-x <right>/<left>); the tab repeat
" group below keeps a bare n/p/./, walking afterwards
map <leader>wn <action>(org-netbeans-core-windows-actions-NextTabAction)
desc <leader>wn next tab
map <leader>wp <action>(org-netbeans-core-windows-actions-PreviousTabAction)
desc <leader>wp previous tab
map <leader>w. <action>(org-netbeans-core-windows-actions-NextTabAction)
desc <leader>w. next tab
map <leader>w, <action>(org-netbeans-core-windows-actions-PreviousTabAction)
desc <leader>w, previous tab
" h/j/k/l: directional window focus from the caret — editor splits AND diff
" panes
map <leader>wh <action>(netmeow.windmoveLeft)
desc <leader>wh focus left
map <leader>wj <action>(netmeow.windmoveDown)
desc <leader>wj focus down
map <leader>wk <action>(netmeow.windmoveUp)
desc <leader>wk focus up
map <leader>wl <action>(netmeow.windmoveRight)
desc <leader>wl focus right
" H/L: NetBeans has no swap-with-the-neighbouring-split, so the capitals shift
" this document's tab within its group instead; there is no up/down analog.
map <leader>wH <action>(org-netbeans-core-windows-actions-MoveWindowLeftAction)
desc <leader>wH shift tab left
map <leader>wL <action>(org-netbeans-core-windows-actions-MoveWindowRightAction)
desc <leader>wL shift tab right
map <leader>wi <action>(zoom-text-in)
desc <leader>wi zoom in
map <leader>w= <action>(zoom-text-in)
desc <leader>w= zoom in
map <leader>wo <action>(zoom-text-out)
desc <leader>wo zoom out
map <leader>w- <action>(zoom-text-out)
desc <leader>w- zoom out

" --- SPC ; — settings / UI ---------------------------------------------------
desc <leader>; settings / UI
map <leader>;C <action>(org-netbeans-modules-project-ui-CloseProject)
desc <leader>;C close project
map <leader>;d <action>(org-netbeans-core-windows-actions-ShowEditorOnlyAction)
desc <leader>;d editor only
map <leader>;f <action>(org-netbeans-core-windows-actions-ToggleFullScreenAction)
